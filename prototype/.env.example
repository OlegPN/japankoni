# Скопируй в .env.local и заполни.
# .env.local НЕ коммитится в git (см. .gitignore в корне репо).

# ElevenLabs — для генерации аудио карточек и сцен
ELEVENLABS_API_KEY=
# Voice IDs — взять с https://elevenlabs.io/app/voice-library (фильтр Language=Japanese)
# A — мужской (например, Takuya = qUwSd7MP6U5NwjUCp4q4)
ELEVENLABS_VOICE_A=
# B — женский (например, Yui = fUjY9K2nAIwlALOwSiwc) — также используется для всех learning-карточек
ELEVENLABS_VOICE_B=

# OpenAI — для AI-Кони (Talk-фаза)
# Префикс NEXT_PUBLIC_ т.к. Capacitor static export не поддерживает рантайм-API-routes —
# ключ должен быть доступен клиентскому JS. Для прототипа OK; для public release
# нужен бэкенд-прокси (ключ не должен попадать в APK distribution).
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini
